{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Agent(Explore)",
      "Agent(Plan)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:github.com)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(rg *)",
      "PowerShell(uv sync *)",
      "PowerShell(uv run *)",
      "PowerShell(npm ci *)",
      "PowerShell(npx playwright *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "Bash(rg *)",
      "Bash(uv sync *)",
      "Bash(uv run *)",
      "Bash(npm ci *)",
      "Bash(npx playwright *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)"
    ]
  }
}
